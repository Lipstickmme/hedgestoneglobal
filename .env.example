# Copy to .env for local dev; set the same keys in Vercel, Settings,
# Environment Variables (Production and Preview).
#
# Everything here is server-only. The browser is handed the Supabase URL and
# anon key at runtime from /api/public-config, so no value needs a VITE_ or
# NEXT_PUBLIC_ prefix and nothing needs a rebuild when a key changes.
# Never put a public prefix on a secret.

# --- Supabase (required) ---------------------------------------------------
# Vercel's Supabase integration injects these automatically under its own
# names, and all of them are recognised: SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
# / VITE_SUPABASE_URL for the URL, SUPABASE_ANON_KEY for the anon key, and
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY for the service role.
# Connect it and skip this block. For local dev, set:
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Public by design: row level security protects the data, not the secrecy of
# this key. The chat widget needs it to sign in anonymously, and /admin
# reports the backend as not connected without it.
#
# Supabase has called this key two things. Projects on the older scheme call it
# the anon key; projects on the newer API keys scheme call it the publishable
# key (sb_publishable_...), and the Vercel integration injects it as
# SUPABASE_PUBLISHABLE_KEY. Any of these names works:
#   SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, VITE_SUPABASE_ANON_KEY,
#   SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#   VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY="eyJ..."

# SECRET. Bypasses row level security. Used only by the server, never sent to
# the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Email via Resend (optional) -------------------------------------------
# Without RESEND_API_KEY the site still runs: sends are skipped and logged, and
# the database remains the source of truth for every message.
RESEND_API_KEY=""

# Svix signing secret from Resend, Webhooks. Starts whsec_. Without it,
# /api/inbound/resend refuses every request rather than trusting unsigned posts.
RESEND_WEBHOOK_SECRET=""

# Where form notifications land, and the address mail is sent as. FORM_FROM's
# domain must be verified in Resend or sending returns 403.
FORM_TO="studio@yourdomain.com"
FORM_FROM="Merkel Website <website@yourdomain.com>"
MAILBOX_ADDRESS="Merkel Constructions <studio@yourdomain.com>"

# The name beside the address on replies sent from /admin. Only used when
# MAILBOX_ADDRESS carries no display name of its own: without one, a reply from
# contact@ arrives in the recipient's inbox as "contact".
STUDIO_NAME="Merkel Constructions"

# Optional safety copy of every inbound message. MUST be a mailbox on another
# domain: pointing it at one of this site's own addresses loops mail back into
# the webhook until the sending quota is gone. /api/health warns if it would,
# and the webhook refuses to forward in that case.
FORWARD_TO=""

# --- Behaviour -------------------------------------------------------------
# Notify on every live-chat message as well as enquiries. Set "off" to silence.
CHAT_NOTIFY=on

# Local only. Where file storage writes when Supabase is not configured.
DATA_DIR=

PORT=3000
NODE_ENV=development

# API rate limiting (the signed inbound webhook is exempt).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ===========================================================================
# Rockfield banking application
# ===========================================================================

# SECRET, and the most important value here. Social Security numbers, card
# numbers and identity document numbers are encrypted with AES-256-GCM under a
# key derived from this. Without it the application starts on a fixed
# development key and says so loudly on every boot: usable locally, never in
# production. Rotating it makes existing encrypted values unreadable, so set it
# once, before the first customer is registered, and keep it.
#   openssl rand -hex 32
BANK_ENCRYPTION_KEY=""

# The first administrator, created the first time the bank is started with an
# empty database. Change the password immediately after the first sign-in, or
# set your own here before the first boot.
BANK_ADMIN_EMAIL="admin@rockfieldglobalfinance.com"
BANK_ADMIN_PASSWORD="Rockfield#Admin2026"

# The demonstration customer that ships with the seeded data, so the dashboard
# has something to show. Remove the seeded customers before running this for
# real: they have balances and history that are not yours.
BANK_DEMO_EMAIL="demo@rockfieldglobalfinance.com"
BANK_DEMO_PASSWORD="Bedrock#Demo2026"

# Where alert emails come from. Falls back to FORM_FROM, then to Resend's
# onboarding sender. Use an address on a domain verified with Resend.
BANK_ALERT_FROM="Rockfield National Bank <alerts@rockfieldglobalfinance.com>"

# --- Text messages via Pingram (optional) ----------------------------------
# Same shape as Resend: without PINGRAM_API_KEY every alert is still raised and
# stored, only the text is not delivered. A customer is texted when their
# mobile number can be read as E.164; an ambiguous one is skipped rather than
# guessed at. See docs/RUNNING-THE-BANK.md.
PINGRAM_API_KEY=""

# The sending number texts come from, in E.164.
PINGRAM_SMS_FROM=""

# The country code assumed for a ten-digit number with no + (default 1).
PINGRAM_DEFAULT_COUNTRY="1"

# Override only if Pingram's send path differs from https://api.pingram.io/sms.
PINGRAM_SMS_URL=""

# The absolute base URL, used in the links inside alert emails and on the link
# card. On Vercel this is derived from VERCEL_URL when unset, which is a
# deployment URL rather than your domain, so set it in production.
#
# Vercel will not let a PUBLIC_-prefixed variable be marked Sensitive - it
# reads the prefix as a front-end framework's and refuses to hold such a name
# as a secret. Save it as plain text, which is right for a domain name, or use
# BANK_BASE_URL or APP_URL instead: both are read in the same places.
PUBLIC_BASE_URL="https://rockfieldglobalfinance.com"

# Requests per minute per IP against /api/bank (default 300) and sign-in
# attempts per five minutes (default 20). The banking dashboard makes a dozen
# calls per screen, which is why it does not share the site-wide limit.
BANK_RATE_LIMIT_MAX="300"
BANK_LOGIN_RATE_LIMIT="20"

# Set to 1 only when running the application over plain HTTP locally. It drops
# the Secure flag from the session cookie so a local browser will keep it.
BANK_COOKIE_INSECURE=""

# Hands one-time codes back in API responses and shows the demonstration
# logins on the sign-in page. On by default only on a laptop with no mail
# provider, so local development can sign into itself; off on any deployment
# and off whenever RESEND_API_KEY is set. Turn it on deliberately for a public
# demonstration, and understand what it means: /auth/forgot will hand a
# password reset code to anyone who posts an address.
BANK_SHOW_DEV_CODES=""

# Where the file-backed store writes when Supabase is not configured. Default
# is ./data locally and /tmp/rockfield-data on Vercel, where nothing survives
# between invocations - so production needs Supabase.
DATA_DIR=""
