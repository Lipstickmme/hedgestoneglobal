# Hedgestone Global Bank - environment variables
#
# Copy to .env for local dev. On Vercel, set the same keys under
# Project, Settings, Environment Variables, ticking Production AND Preview,
# then REDEPLOY: a variable added after a deployment is not seen by it.
#
# Everything here is server-only. The browser is handed the Supabase URL and
# anon key at runtime from /api/public-config, so no value needs a VITE_ or
# NEXT_PUBLIC_ prefix and nothing needs a rebuild when a key changes.
# Never put a public prefix on a secret.
#
# Vercel checklist
#   REQUIRED for a working production bank:
#     SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#     BANK_ENCRYPTION_KEY, BANK_ADMIN_EMAIL, BANK_ADMIN_PASSWORD,
#     PUBLIC_BASE_URL
#   REQUIRED for email (enquiries, chat, alerts, OTP codes):
#     RESEND_API_KEY, FORM_TO, FORM_FROM, BANK_ALERT_FROM
#   REQUIRED for inbound mail on your domain:
#     RESEND_WEBHOOK_SECRET, MAILBOX_ADDRESS
#   RECOMMENDED for live prices: FINNHUB_API_KEY (free at finnhub.io)
#   OPTIONAL: everything else below.
#   Do NOT set on Vercel: PORT, DATA_DIR, BANK_COOKIE_INSECURE, NODE_ENV,
#     MARKET_DATA_FIXTURE.
#   Set automatically by Vercel (never set by hand): VERCEL, VERCEL_ENV,
#     VERCEL_URL, VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF.
#
# /api/health on the deployed site reports which of these the server can see,
# and the staff console's Setup checklist (/console#setup) turns it into a
# to-do list. Database tables: paste supabase/setup.sql into the Supabase
# SQL Editor once.

# ===========================================================================
# 1. Supabase (REQUIRED in production)
# ===========================================================================
# Without these the app still boots, but stores data in /tmp on Vercel, where
# nothing survives between requests. Paste supabase/setup.sql (migrations
# 0001..0006 in one file) into the Supabase SQL editor first.
#
# Vercel's Supabase integration injects these automatically under its own
# names, and all of them are recognised:
#   URL:          SUPABASE_URL | NEXT_PUBLIC_SUPABASE_URL | VITE_SUPABASE_URL
#   anon key:     SUPABASE_ANON_KEY | SUPABASE_PUBLISHABLE_KEY |
#                 NEXT_PUBLIC_SUPABASE_ANON_KEY | NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY |
#                 VITE_SUPABASE_ANON_KEY | VITE_SUPABASE_PUBLISHABLE_KEY
#   service role: SUPABASE_SERVICE_ROLE_KEY | SUPABASE_SECRET_KEY
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Public by design: row level security protects the data, not the secrecy of
# this key. The chat widget and /admin need it. Newer projects call it the
# publishable key (sb_publishable_...).
SUPABASE_ANON_KEY="eyJ..."

# SECRET. Bypasses row level security. Server only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ===========================================================================
# 2. The bank (REQUIRED in production)
# ===========================================================================

# SECRET, and the most important value here. SSNs, card numbers and ID numbers
# are encrypted with AES-256-GCM under a key derived from this. Without it the
# app runs on a fixed development key: fine locally, never in production.
# Set it ONCE, before the first customer: rotating it makes stored values
# unreadable.
#   openssl rand -hex 32
BANK_ENCRYPTION_KEY=""

# The administrator for /console. Reconciled on every boot. Change the password
# after the first sign-in.
BANK_ADMIN_EMAIL="admin@hedgestonesfinance.com"
BANK_ADMIN_PASSWORD="Hedgestone#Admin2026"

# Optional: set to 1 to force the administrator's password back to
# BANK_ADMIN_PASSWORD on the next boot. Unset it afterwards.
BANK_ADMIN_RESET=""

# The absolute site URL, used in links inside emails and on the link card.
# On Vercel it otherwise falls back to VERCEL_URL (the deployment URL, not your
# domain). Vercel refuses to mark a PUBLIC_-prefixed variable Sensitive: save it
# as plain text, or use BANK_BASE_URL or APP_URL instead (same meaning).
PUBLIC_BASE_URL="https://hedgestonesfinance.com"

# Optional: the seeded demonstration customer. Must differ from
# BANK_ADMIN_EMAIL. Remove seeded customers before running for real.
BANK_DEMO_EMAIL="demo@hedgestonesfinance.com"
BANK_DEMO_PASSWORD="Bedrock#Demo2026"

# Optional: the display name used as the sender on replies from /admin and in
# alerts when an address carries no name of its own. STUDIO_NAME is accepted
# as an older alias.
BANK_NAME="Hedgestone Global Bank"

# ===========================================================================
# 3. Email via Resend (REQUIRED for any email to be delivered)
# ===========================================================================
# Without RESEND_API_KEY the site still runs: sends are skipped and logged, and
# one-time codes cannot reach customers. The sending domain
# (hedgestonesfinance.com) must be verified in Resend, or sends return 403.
RESEND_API_KEY=""

# Where enquiry and chat notifications land. (Alias: CONTACT_NOTIFY_EMAIL)
FORM_TO="support@hedgestonesfinance.com"

# The identity website mail is sent as. (Alias: NOTIFY_FROM)
FORM_FROM="Hedgestone Global Bank <website@hedgestonesfinance.com>"

# Sender for banking alerts and one-time codes. Falls back to FORM_FROM.
BANK_ALERT_FROM="Hedgestone Global Bank <alerts@hedgestonesfinance.com>"

# Optional: override only if pointing at a Resend-compatible proxy.
RESEND_API_BASE=""

# ===========================================================================
# 4. Inbound mail on your domain (REQUIRED only for the /admin mailbox)
# ===========================================================================
# Svix signing secret from Resend, Webhooks (starts whsec_). Without it,
# /api/inbound/resend refuses every request.
RESEND_WEBHOOK_SECRET=""

# The address that receives mail.
MAILBOX_ADDRESS="Hedgestone Global Bank <support@hedgestonesfinance.com>"

# Optional safety copy of every inbound message. MUST be a mailbox on ANOTHER
# domain, or mail loops back into the webhook. No default.
FORWARD_TO=""

# ===========================================================================
# 5. Notifications (optional)
# ===========================================================================
# Notify on every live-chat message as well as enquiries. "off" silences it.
CHAT_NOTIFY="on"

# Slack / Discord / Zapier / desk webhook that also receives notifications.
NOTIFY_WEBHOOK_URL=""

# ===========================================================================
# 6. Text messages via Pingram (optional)
# ===========================================================================
# Without PINGRAM_API_KEY alerts are still raised and stored, just not texted.
PINGRAM_API_KEY=""
# sending number, E.164 (+18005559999)
PINGRAM_SMS_FROM=""
# assumed for ten-digit numbers with no +
PINGRAM_DEFAULT_COUNTRY="1"
# default https://api.pingram.io/sms
PINGRAM_SMS_URL=""

# ===========================================================================
# 6b. Live market prices (optional, works without any key)
# ===========================================================================
# The ticker under the nav and the Invest screen price ten assets (S&P 500 and
# Nasdaq-100 ETFs, Apple, Amazon, Microsoft, NVIDIA, Alphabet, Tesla, Bitcoin,
# gold). With no key, stocks come from Yahoo Finance then Stooq, Bitcoin from
# CoinGecko then Coinbase, gold from Stooq then Yahoo. A free Finnhub key
# (finnhub.io) gives real-time US stock and ETF quotes and is the most
# dependable source from a cloud host, so set it in production.
FINNHUB_API_KEY=""
# How long one round of prices is reused before asking again (seconds).
MARKET_CACHE_SECONDS="30"
# A conversion is refused if the freshest price is older than this (seconds).
MARKET_TRADE_MAX_AGE_SECONDS="120"
# Tests and offline demos only: fixed prices, labelled "Demo prices" on screen.
# Never set this on a real deployment.
MARKET_DATA_FIXTURE=""

# ===========================================================================
# 7. Limits and behaviour (optional, defaults are fine)
# ===========================================================================
# site-wide API window
RATE_LIMIT_WINDOW_MS="60000"
# site-wide API requests per window
RATE_LIMIT_MAX="30"
# /api/bank requests per minute per IP
BANK_RATE_LIMIT_MAX="300"
# sign-in attempts per five minutes per IP
BANK_LOGIN_RATE_LIMIT="20"

# Returns one-time codes in API responses and shows demo logins on /signin.
# Off on any deployment and whenever RESEND_API_KEY is set. Turn it on only for
# a public demonstration: /auth/forgot will then hand a reset code to anyone.
BANK_SHOW_DEV_CODES=""

# ===========================================================================
# 8. Local development only (do NOT set on Vercel)
# ===========================================================================
PORT="3000"
NODE_ENV="development"
# Drops the Secure flag from the session cookie for plain-HTTP localhost.
BANK_COOKIE_INSECURE=""
# File store location when Supabase is not configured (default ./data).
DATA_DIR=""
