{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/accounts",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/statements",
      "destination": "/history",
      "permanent": true
    },
    {
      "source": "/bills",
      "destination": "/send",
      "permanent": true
    },
    {
      "source": "/deposit",
      "destination": "/receive",
      "permanent": true
    },
    {
      "source": "/cards",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/invest",
      "destination": "/vault",
      "permanent": true
    },
    {
      "source": "/transactions",
      "destination": "/history",
      "permanent": true
    },
    {
      "source": "/transfers",
      "destination": "/send",
      "permanent": true
    },
    {
      "source": "/recipients",
      "destination": "/send",
      "permanent": true
    },
    {
      "source": "/personal",
      "destination": "/bitcoin",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/bitcoin",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/bitcoin",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/bitcoin",
      "permanent": true
    },
    {
      "source": "/digital",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/support"
    },
    {
      "source": "/login",
      "destination": "/signin"
    },
    {
      "source": "/desk",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
